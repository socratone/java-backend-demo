#!/bin/sh
set -eu

MAVEN_VERSION=3.9.9
MAVEN_DISTRIBUTION_URL=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip
MAVEN_DIST_ROOT="${HOME}/.m2/wrapper/dists"
MAVEN_HOME="${MAVEN_DIST_ROOT}/apache-maven-${MAVEN_VERSION}"

if [ ! -x "${MAVEN_HOME}/bin/mvn" ]; then
    mkdir -p "${MAVEN_DIST_ROOT}"
    archive="${TMPDIR:-/tmp}/apache-maven-${MAVEN_VERSION}-bin.zip"
    echo "Downloading Apache Maven ${MAVEN_VERSION}..."
    curl -fsSL "${MAVEN_DISTRIBUTION_URL}" -o "${archive}"
    unzip -q -o "${archive}" -d "${MAVEN_DIST_ROOT}"
    rm -f "${archive}"
fi

exec "${MAVEN_HOME}/bin/mvn" "$@"
